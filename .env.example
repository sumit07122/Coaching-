# ==============================================================================
# FIXIA CoachingOS — Environment Variables Configuration
# Copy this file to .env.local for local overrides
# ==============================================================================

# Supabase Project URL
# Find in: Supabase Dashboard > Project Settings > API > Project URL
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anonymous API Key (Safe for frontend exposure)
# Find in: Supabase Dashboard > Project Settings > API > Project API keys > anon / public
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Application Environment Mode: 'development' | 'production' | 'test'
# In 'production', mock logins are disabled and genuine Supabase credentials are strictly required.
VITE_APP_ENV=development

# ------------------------------------------------------------------------------
# SECURITY WARNING:
# - NEVER put the Supabase 'service_role' key in this file or any VITE_* variable.
# - The service-role key bypasses PostgreSQL Row Level Security (RLS).
# - FIXIA CoachingOS includes a client-side security guard that immediately blocks
#   and reports any attempt to use a service-role key in the frontend client.
# ------------------------------------------------------------------------------
